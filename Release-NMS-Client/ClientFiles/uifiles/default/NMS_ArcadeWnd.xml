<?xml version="1.0" encoding="us-ascii"?>
<XML ID="EQInterfaceDefinitionLanguage">
  <Schema xmlns="EverQuestData" xmlns:dt="EverQuestDataTypes" />
  <!-- NMS script windows (arcade): bare shell only. All content inside the
       window is drawn by eqgame_dll/nms_window.cpp through the d3d9 hook;
       the title bar gives native dragging, and NMSArcadeClose is the DLL's
       own close button (the native closebox stays off so the DLL always
       learns about closes). Button pieces mirror NMS_WaypointsWnd.xml
       (inline ButtonDrawTemplate on the shared EQLS window pieces) so the
       parser sees nothing it has not already accepted. -->
  <TextureInfo item="EQLS_window_pieces_01.tga">
    <Size>
      <CX>256</CX>
      <CY>256</CY>
    </Size>
  </TextureInfo>
  <Ui2DAnimation item="A_EQLS_LargeBtnNormal">
    <Cycle>true</Cycle>
    <Frames>
      <Texture>EQLS_window_pieces_01.tga</Texture>
      <Location>
        <X>0</X>
        <Y>34</Y>
      </Location>
      <Size>
        <CX>244</CX>
        <CY>32</CY>
      </Size>
      <Hotspot>
        <X>0</X>
        <Y>0</Y>
      </Hotspot>
      <Duration>1000</Duration>
    </Frames>
  </Ui2DAnimation>
  <Ui2DAnimation item="A_EQLS_LargeBtnHover">
    <Cycle>true</Cycle>
    <Frames>
      <Texture>EQLS_window_pieces_01.tga</Texture>
      <Location>
        <X>0</X>
        <Y>65</Y>
      </Location>
      <Size>
        <CX>244</CX>
        <CY>32</CY>
      </Size>
      <Hotspot>
        <X>0</X>
        <Y>0</Y>
      </Hotspot>
      <Duration>1000</Duration>
    </Frames>
  </Ui2DAnimation>
  <Ui2DAnimation item="A_EQLS_LargeBtnPressed">
    <Cycle>true</Cycle>
    <Frames>
      <Texture>EQLS_window_pieces_01.tga</Texture>
      <Location>
        <X>0</X>
        <Y>96</Y>
      </Location>
      <Size>
        <CX>244</CX>
        <CY>32</CY>
      </Size>
      <Hotspot>
        <X>0</X>
        <Y>0</Y>
      </Hotspot>
      <Duration>1000</Duration>
    </Frames>
  </Ui2DAnimation>
  <Ui2DAnimation item="A_EQLS_LargeBtnDisabled">
    <Cycle>true</Cycle>
    <Frames>
      <Texture>EQLS_window_pieces_01.tga</Texture>
      <Location>
        <X>0</X>
        <Y>127</Y>
      </Location>
      <Size>
        <CX>244</CX>
        <CY>32</CY>
      </Size>
      <Hotspot>
        <X>0</X>
        <Y>0</Y>
      </Hotspot>
      <Duration>1000</Duration>
    </Frames>
  </Ui2DAnimation>
  <Ui2DAnimation item="A_EQLS_LargeBtnPressedHover">
    <Cycle>true</Cycle>
    <Frames>
      <Texture>EQLS_window_pieces_01.tga</Texture>
      <Location>
        <X>0</X>
        <Y>158</Y>
      </Location>
      <Size>
        <CX>244</CX>
        <CY>32</CY>
      </Size>
      <Hotspot>
        <X>0</X>
        <Y>0</Y>
      </Hotspot>
      <Duration>1000</Duration>
    </Frames>
  </Ui2DAnimation>

  <Button item="NMSArcadeClose">
    <ScreenID>NMSArcadeClose</ScreenID>
    <Font>4</Font>
    <RelativePosition>true</RelativePosition>
    <Location>
      <X>364</X>
      <Y>2</Y>
    </Location>
    <Size>
      <CX>24</CX>
      <CY>18</CY>
    </Size>
    <Style_Checkbox>false</Style_Checkbox>
    <Text>X</Text>
    <TextColor>
      <R>255</R>
      <G>215</G>
      <B>0</B>
    </TextColor>
    <ButtonDrawTemplate>
      <Normal>A_EQLS_LargeBtnNormal</Normal>
      <Pressed>A_EQLS_LargeBtnPressed</Pressed>
      <Flyby>A_EQLS_LargeBtnHover</Flyby>
      <Disabled>A_EQLS_LargeBtnDisabled</Disabled>
      <PressedFlyby>A_EQLS_LargeBtnPressedHover</PressedFlyby>
    </ButtonDrawTemplate>
  </Button>

  <Screen item="NMS_ArcadeShell">
    <RelativePosition>false</RelativePosition>
    <Location>
      <X>120</X>
      <Y>100</Y>
    </Location>
    <Size>
      <CX>400</CX>
      <CY>320</CY>
    </Size>
    <Text></Text>
    <Style_VScroll>false</Style_VScroll>
    <Style_Border>true</Style_Border>
    <Style_Transparent>false</Style_Transparent>
    <DrawTemplate>WDT_Filigree</DrawTemplate>
    <Style_Titlebar>true</Style_Titlebar>
    <Style_Closebox>false</Style_Closebox>
    <Escapable>true</Escapable>
    <Style_Minimizebox>false</Style_Minimizebox>
    <Pieces>NMSArcadeClose</Pieces>
  </Screen>
</XML>

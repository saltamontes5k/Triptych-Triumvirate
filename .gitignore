# Compiled binaries are never tracked - this repo ships source only.
# Build outputs and runtime payloads stay out of git; build from source.
*.exe
*.dll
*.lib
*.so
*.pdb

# --- Secrets / local configs (never commit) ---
Release-NMS-Server/eqemu_config.json
Release-NMS-Server/eqemu_config.json.bak-pre-spire
Release-NMS-Server/login.json

# --- Server build / runtime (recreate locally, never commit) ---
Release-NMS-Server/Build/
Release-NMS-Server/vcpkg/
Release-NMS-Server/perl/
Release-NMS-Server/logs/
Release-NMS-Server/shared_memory/
Release-NMS-Server/release-peq.sql
Release-NMS-Server/export/
Release-NMS-Server/bin/
Release-NMS-Server/shared/

# --- Client-derived data (Daybreak copyright - recreate locally, never commit) ---
Release-NMS-Server/bin/Release/lon_data/
Release-NMS-Client/ClientFiles/*.txt
Release-NMS-Client/ClientFiles/*.bak-*
Release-NMS-Client/ClientFiles/Resources/*.txt

# --- Maps: repo-root maps/ not tracked; Release-NMS-Server/maps/ ships ---
/maps/

# --- Player / private data ---
backups/

# --- IDE / editor ---
.vs/
.vscode/
*.user
*.suo
*.sln.docstates
*.VC.db
*.opendb
*.ipch
*.idb
.idea/

# --- Build outputs (client add-on) ---
Release-NMS-Client/eqgame_dll/Release/
Release-NMS-Client/eqgame_dll/Intermediate/
Release-NMS-Client/eqgame_dll/msvc/
Release-NMS-Client/eqgame_dll/eqgame_dll_rof2/Release/
Release-NMS-Client/Release/
*.recipe
*.tlog
*.log

# --- OS cruft ---
Thumbs.db
.DS_Store
desktop.ini
__pycache__/
